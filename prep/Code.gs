function fail(m){ throw new Error(m); }
function props_(){ return PropertiesService.getScriptProperties(); }
function ss_(){ const a = SpreadsheetApp.getActive(); if(a) return a;   // standalone project: makes its own sheet the first time
  const p = props_(); let id = p.getProperty('SHEET_ID');
  if(!id){ id = SpreadsheetApp.create('Academic Preparation Data').getId(); p.setProperty('SHEET_ID', id); }
  return SpreadsheetApp.openById(id); }
function sheet_(name){
  const ss = ss_(); let sh = ss.getSheetByName(name);
  if(!sh){ sh = ss.insertSheet(name);
    const h = name === 'Docs' ? HEAD.concat(Array.from({length: DOC_CHUNKS}, (_, i) => 'json' + (i+1))) : ['time','who','path','what'];
    sh.getRange(1,1,1,h.length).setValues([h]).setFontWeight('bold'); sh.setFrozenRows(1); }
  return sh;
}
/* ---------- who is updating (no password: each phone sends the name the person typed) ---------- */
function first_(name){ return String(name||'').trim().split(/\s+/)[0].toLowerCase().replace(/[^a-z]/g,''); }
function isAdmin_(name){ const a = String(props_().getProperty('PREP_ADMINS') || 'shubhangi').toLowerCase().split(/[,\s]+/).filter(Boolean); return a.indexOf(first_(name)) >= 0; }
function who_(name){ name = String(name||'').trim().replace(/\s+/g,' ').slice(0, 60); if(name.length < 3) fail('NAME'); return name; }
function log_(who, path, what){ try{ sheet_('Log').appendRow([Utilities.formatDate(new Date(), TZ, 'yyyy-MM-dd HH:mm:ss'), who, path, what]); }catch(e){} }
/* ---------- documents ---------- */
const PATH_RE = /^(plan\/[A-Za-z0-9_.\-]{1,40}|status\/[A-Za-z0-9_.\-]{1,140})$/;
function coll_(path){ if(!PATH_RE.test(String(path||''))) fail('Bad record.'); return path.split('/')[0]; }
function rev_(next){ const p = props_(); let r = Number(p.getProperty('rev') || 0); if(next){ r++; p.setProperty('rev', String(r)); } return r; }
function rowOf_(sh, key){ if(sh.getLastRow() < 2) return 0;
  const c = sh.getRange(2,1,sh.getLastRow()-1,1).createTextFinder(key).matchEntireCell(true).findNext(); return c ? c.getRow() : 0; }
function read_(test){
  const sh = sheet_('Docs'), n = sh.getLastRow() - 1; if(n < 1) return [];
  const head = sh.getRange(2,1,n,HEAD.length).getValues(), hit = [];
  head.forEach((v,i) => { v[0] = String(v[0]); if(test(v)) hit.push(i); }); if(!hit.length) return [];
  const body = sh.getRange(2,HEAD.length+1,n,DOC_CHUNKS).getValues();
  return hit.map(i => { const v = head[i];
    if(v[4] === true || v[4] === 'TRUE') return {p: v[0], del: 1};
    let j = null; try{ j = JSON.parse(body[i].join('')); }catch(e){} return j ? {p: v[0], j: j} : null; }).filter(Boolean);
}
function get_(path){ const d = read_(v => v[0] === path)[0]; return d && d.j ? d.j : null; }
function write_(path, obj, who, what){
  const coll = coll_(path), json = JSON.stringify(obj);
  if(json.length > CHUNK*DOC_CHUNKS) fail('This record is too large to save.');
  const rev = rev_(true), sh = sheet_('Docs');
  const row = [path, coll, coll, rev, false, new Date().toISOString()].concat(Array.from({length: DOC_CHUNKS}, (_, i) => json.slice(i*CHUNK, (i+1)*CHUNK)));
  const r = rowOf_(sh, path); if(r) sh.getRange(r,1,1,row.length).setValues([row]); else sh.appendRow(row);
  log_(who, path, what || 'saved'); return rev;
}
const API = {
  me(who){ return {name: who, admin: isAdmin_(who)}; },
  all(){ return {rev: rev_(), docs: read_(() => true)}; },
  sync(since){ since = Number(since) || 0; const rev = rev_();
    if(since >= rev) return {rev: rev, docs: []};
    return {rev: rev, docs: read_(v => Number(v[3]) > since)}; },
  // a mark or remark on one lesson: merged into the record, name and time stamped by the server
  merge(path, fields, who){
    if(coll_(path) !== 'status') fail('Bad record.');
    fields = fields && typeof fields === 'object' ? fields : {};
    const role = /^(Dean|PL)$/.test(String(fields.role)) ? String(fields.role) : '';
    const now = Date.now(), cur = get_(path) || {}; let changed = 0;
    Object.keys(fields).forEach(k => {
      let v = fields[k];
      if(FIELDS.indexOf(k) >= 0){ if(!/^[XPDN]$/.test(String(v))) return; }
      else if(TEXT_FIELDS.indexOf(k) >= 0){ v = String(v || '').slice(0, 200); }
      else return;
      cur[k] = v; cur[k + '_by'] = who; cur[k + '_role'] = role; cur[k + '_at'] = now; changed++;
    });
    if(!changed) fail('Nothing to save.');
    cur.by = who; cur.role = role; cur.t = now;
    const rev = write_(path, cur, who, Object.keys(fields).filter(k => k !== 'role').map(k => k + '=' + String(fields[k]).slice(0, 40)).join(', '));
    return {rev: rev, j: cur};
  },
  // lesson plans for a month (loading a planner, setting a lesson's date): Dean / Director only
  set(path, obj, who){
    if(coll_(path) !== 'plan') fail('Bad record.');
    if(!isAdmin_(who)) fail('Only the Dean or the Director can change the lesson plan.');
    if(!obj || typeof obj !== 'object' || Array.isArray(obj)) fail('Bad record.');
    return {rev: write_(path, obj, who, 'plan saved')};
  },
  // one-time import of a lesson file (plans and earlier marks) prepared by Claude
  importFile(data, who){
    if(!isAdmin_(who)) fail('Only the Dean or the Director can load a lesson file.');
    data = data && typeof data === 'object' ? data : {}; let n = 0;
    Object.keys(data).forEach(path => { coll_(path); const o = data[path];
      if(o && typeof o === 'object' && !Array.isArray(o)){ write_(path, o, who, 'imported'); n++; } });
    return {rev: rev_(), n: n};
  }
};
function doPost(e){
  let req = {}; try{ req = JSON.parse(e.postData.contents); }catch(x){}
  const out = o => ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
  const fn = API[req.fn]; if(!fn) return out({ok: false, err: 'Unknown request.'});
  const write = ['merge','set','importFile'].indexOf(req.fn) >= 0, lock = LockService.getScriptLock();
  try{
    let args = req.args || [];
    const who = who_(req.who);
    if(req.fn === 'me') args = [who];
    else if(req.fn === 'importFile') args = [args[0], who];
    else if(write) args = args.slice(0, 2).concat([who]);
    if(write && !lock.tryLock(25000)) return out({ok: false, err: 'Server busy, trying again.'});
    return out({ok: true, v: fn.apply(null, args)});
  }catch(x){ const m = String(x && x.message || x); return out({ok: false, err: m === 'NAME' ? 'Type your full name first.' : m, name: m === 'NAME' ? 1 : 0});
  }finally{ if(write) try{ lock.releaseLock(); }catch(x){} }
}
